# Rin 本地开发配置
# 复制此文件为 .env.local 并填入你的实际配置

# Cloudflare 资源名称（部署时使用）
WORKER_NAME=rin-server
PAGES_PROJECT_NAME=rin-client
DB_NAME=rin
R2_BUCKET_NAME=rin-server-objects

# ============================================
# 站点配置（可选，默认值如下）
# 注意：这些配置可以在部署后通过设置页面修改
# 配置优先级：设置页面 > 环境变量 > 默认值
# ============================================

# 网站基本信息（默认：Rin）
# NAME=Rin

# 网站描述（默认：A lightweight personal blogging system）
# DESCRIPTION=A lightweight personal blogging system

# 头像地址（默认：空）
# AVATAR=

# 分页大小（默认：5）
# PAGE_SIZE=5

# RSS 设置（默认：false）
# RSS_ENABLE=false

# 站点公开地址，用于定时生成 RSS（例如 https://blog.example.com）
SITE_URL=

# 额外允许携带 Cookie 调用 API 的来源，多个来源用逗号分隔
CORS_ALLOWED_ORIGINS=

# 旧版原始访问记录保留天数（v1.0 起不再新增原始 IP，默认 30）
VISIT_RETENTION_DAYS=30

# ============================================
# 后端配置 (wrangler.toml 中的 vars)
# ============================================
BACKEND_PORT=11498

# S3/R2 存储配置
S3_FOLDER=images/
S3_CACHE_FOLDER=cache/
S3_REGION=auto
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_ACCESS_HOST=https://your-image-domain.com
S3_BUCKET=your-bucket-name
S3_FORCE_PATH_STYLE=false

# 缓存存储模式配置
# database: 使用 D1 存储缓存（默认，避免与公开图片共享对象命名空间）
# s3: 使用私有 S3/R2 对象存储缓存（仅用于兼容旧部署）
CACHE_STORAGE_MODE=database

# 本地 Workers AI 默认关闭。设为 true 时会连接 Cloudflare 远程 binding。
WORKERS_AI_REMOTE=false

# Webhook 通知地址（可选）
WEBHOOK_URL=

# RSS 标题和描述
RSS_TITLE=Rin Development
RSS_DESCRIPTION=Development Environment

# ============================================
# 敏感配置（会被加密存储）
# ============================================
# GitHub OAuth 配置（必填，后台不支持账号密码登录）
RIN_GITHUB_CLIENT_ID=
RIN_GITHUB_CLIENT_SECRET=
# 创建者的 GitHub 数字用户 ID；只有该用户可以完成登录
RIN_GITHUB_ADMIN_ID=

# JWT 密钥（至少 32 字节；例如：openssl rand -hex 32）
JWT_SECRET=

# S3 访问密钥
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key

# ============================================
# 数据库配置
# ============================================
