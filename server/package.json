{
  "name": "rin-server",
  "version": "1.2.0",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "build": "bun x wrangler deploy --dry-run --outdir=dist",
    "dev": "bun x wrangler dev --port 11498",
    "dev:cron": "bun x wrangler dev --port 11498 --test-scheduled #see https://developers.cloudflare.com/workers/configuration/cron-triggers/#test-cron-triggers",
    "cf-typegen": "bun x wrangler types server/worker-configuration.d.ts --cwd .. --strict-vars=false",
    "db:gen": "bun drizzle-kit generate",
    "migrate:visits": "bun run scripts/migrate-visits.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.1.2",
    "drizzle-kit": "^0.21.2",
    "typescript": "^5.0.4",
    "strip-indent": "^4.0.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@rin/api": "workspace:*",
    "@rin/config": "workspace:*",
    "arctic": "^3.7.0",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "0.45.2",
    "fast-xml-parser": "5.7.0",
    "feed": "^4.2.2",
    "hono": "4.12.34",
    "html-to-md": "^0.8.5",
    "jose": "^5.3.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "unified": "^11.0.4"
  },
  "trustedDependencies": [
    "es5-ext"
  ]
}
